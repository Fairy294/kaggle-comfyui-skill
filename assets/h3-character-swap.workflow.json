    "class_type": "LoadImage",
    "inputs": {
      "image": "start-frame.png"
    }
  },
  "reference": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": [
        "encoder",
        0
      ],
      "vae": [
        "video-vae",
        0
      ],
      "audio_vae": [
        "audio-vae",
        0
      ],
      "prompt": "<Picture 1> defines the identity of the single adult performer. <Picture 2> defines the opaque ankle-length layered costume and framing. Replace only the performer in <Video 1>; follow the original upper-body dance, gesture order, rhythm and scene. Keep the long skirt covering the legs throughout. Frame 0 keyframe defines the actual starting pose; continue its motion without resetting. Fixed centered camera, single sharp subject, consistent face and costume, no scene transitions, no black borders, no text or watermark.",
      "width": 736,
      "height": 992,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": [
        "identity",
        0
      ],
      "ref_images.ref_image_1": [
        "costume",
        0
      ],
      "ref_videos.ref_video_0": [
        "motion-parts",
        0
      ],
      "ref_video_audios.ref_video_audio_0": [
        "motion-parts",
        1
      ]
    }
  },
  "guide": {
    "class_type": "MiniMaxH3AddGuide",
    "inputs": {
      "positive": [
        "reference",
        0
      ],
      "latent": [
        "reference",
        1
      ],
      "vae": [
        "video-vae",
        0
      ],
      "image": [
        "start-frame",
        0
      ],
      "frame_idx": 0
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 12345
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "ref-turbo",
        0
      ],
      "conditioning": [
        "guide",
        0
      ]
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "schedule": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "ref-turbo",
        0
      ],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "schedule",
        0
      ],
      "latent_image": [
        "reference",
        1
